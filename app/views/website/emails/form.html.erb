<%# locals: (email:) -%>
<%# A form email (notification or confirmation) in the site's design, drawn from its blocks each time it's sent. The Forms plugin then repeats the answers row once per answer and fills the {{tokens}}. Mail clients need tables and inline styles, so this uses nothing else: the dark steel and amber of the site's header, footer and closing bands (site.css), in hex. %>
<%# The logo is the theme's own white-and-amber PNG (logo-stella-email.png, on the page colour): Branding's logo is the dark wordmark, which the site's header can only show by turning it white with a CSS filter, and mail clients have no filters. %>
<% c = {page: "#0e0f12", card: "#15171c", tint: "#1a1d23", ink: "#ffffff", text: "#d3d8de", muted: "#a9b0ba", faint: "#808894", rule: "#282d35", amber: "#ffb800", steel: "#111318"} %>
<% head = "'Archivo', 'Helvetica Neue', Helvetica, Arial, sans-serif" %>
<% sans = "'Inter', 'Helvetica Neue', Helvetica, Arial, sans-serif" %>
<% mono = "'IBM Plex Mono', 'SFMono-Regular', Menlo, Consolas, monospace" %>
<% name = stella_site[:name] %>
<% home = website_url("/") %>
<!DOCTYPE html>
<html lang="en">
  <head>
    <meta charset="utf-8">
    <meta name="viewport" content="width=device-width, initial-scale=1">
    <%# Already dark: tells Apple Mail and Outlook not to invert it. %>
    <meta name="color-scheme" content="dark">
    <meta name="supported-color-schemes" content="dark">
    <title><%= email.subject %></title>
  </head>
  <body style="margin:0;padding:0;background:<%= c[:page] %>;">
    <table role="presentation" width="100%" cellpadding="0" cellspacing="0" style="background:<%= c[:page] %>;">
      <tr>
        <td align="center" style="padding:32px 16px;">
          <table role="presentation" width="100%" cellpadding="0" cellspacing="0" style="max-width:600px;">
            <tr>
              <td style="padding:0 8px 18px;">
                <table role="presentation" width="100%" cellpadding="0" cellspacing="0">
                  <tr>
                    <td valign="middle">
                      <%= tag.a href: home, style: "text-decoration:none;" do %><%= tag.img src: website_url(stella_asset_path("logo-stella-email.png")), alt: name, width: 144, height: 24,
                        style: "display:block;width:144px;height:24px;border:0;font-family:#{head};font-size:20px;font-weight:800;letter-spacing:1px;color:#{c[:ink]};" %><% end %>
                    </td>
                    <% if stella_site[:phone].present? %>
                      <td align="right" valign="middle" style="font-family:<%= mono %>;font-size:13px;font-weight:500;letter-spacing:.5px;">
                        <%= tag.a stella_site[:phone], href: stella_site[:phone_href], style: "color:#{c[:amber]};text-decoration:none;" %>
                      </td>
                    <% end %>
                  </tr>
                </table>
              </td>
            </tr>
            <tr>
              <td style="background:<%= c[:card] %>;border:1px solid <%= c[:rule] %>;border-top:4px solid <%= c[:amber] %>;border-radius:10px;padding:36px 36px 28px;">
                <table role="presentation" width="100%" cellpadding="0" cellspacing="0">
                  <% email.content_blocks.each do |block| %>
                    <%= render "website/emails/block", block:, c:, head:, sans:, mono: %>
                  <% end %>
                </table>
              </td>
            </tr>
            <tr>
              <td align="center" style="padding:20px 8px 0;font-family:<%= sans %>;font-size:12px;line-height:1.5;color:<%= c[:faint] %>;">
                <%= name %> &middot; <%= tag.a stella_site[:phone], href: stella_site[:phone_href], style: "color:#{c[:faint]};" %> &middot; <%= tag.a home.sub(%r{\Ahttps?://}, "").chomp("/"), href: home, style: "color:#{c[:faint]};" %>
              </td>
            </tr>
          </table>
        </td>
      </tr>
    </table>
  </body>
</html>
