<%# locals: () -%>
<%# src/components/LilyWidget.astro: a stylized mock of the Lily Pad Connect quote and reservation widget. Decorative. %>
<div class="lp-widget reg" aria-hidden="true" data-c-lily-widget>
  <div class="lp-bar" data-c-lily-widget>
    <span class="lp-mark" data-c-lily-widget>◆ LILY PAD CONNECT</span>
    <span class="lp-live" data-c-lily-widget><span class="live" data-c-lily-widget></span>ON YOUR SITE</span>
  </div>
  <div class="lp-head" data-c-lily-widget>
    <span class="lp-ey" data-c-lily-widget>Get an instant quote</span>
    <p class="lp-promo" data-c-lily-widget>Save up to 25% with code <b data-c-lily-widget>GIFT25</b></p>
  </div>
  <div class="lp-steps" data-c-lily-widget>
    <span class="ok" data-c-lily-widget>Delivery</span>
    <span class="cur" data-c-lily-widget>Container</span>
    <span data-c-lily-widget>Coverage</span>
    <span data-c-lily-widget>Reserve</span>
  </div>
  <div class="lp-opts" data-c-lily-widget>
    <div class="lp-opt" data-c-lily-widget>
      <span class="lp-thumb" data-c-lily-widget></span>
      <div class="lp-meta" data-c-lily-widget><b data-c-lily-widget>8×12 Container</b><span data-c-lily-widget>8'×8'×12'</span></div>
      <span class="lp-price" data-c-lily-widget>$169<i data-c-lily-widget>/mo</i></span>
      <div class="lp-qty" data-c-lily-widget><span data-c-lily-widget>−</span><em data-c-lily-widget>0</em><span class="plus" data-c-lily-widget>+</span></div>
    </div>
    <div class="lp-opt sel" data-c-lily-widget>
      <span class="lp-thumb" data-c-lily-widget></span>
      <div class="lp-meta" data-c-lily-widget><b data-c-lily-widget>8×16 Container</b><span data-c-lily-widget>8'×8'×16'</span></div>
      <span class="lp-price" data-c-lily-widget>$199<i data-c-lily-widget>/mo</i></span>
      <div class="lp-qty" data-c-lily-widget><span data-c-lily-widget>−</span><em data-c-lily-widget>1</em><span class="plus" data-c-lily-widget>+</span></div>
    </div>
  </div>
  <button class="lp-reserve" type="button" tabindex="-1" data-c-lily-widget>Reserve now · pay later →</button>
</div>
