<%# locals: (eyebrow:, title:, form_id: "hero-demo", logo: nil, logo_alt: "") -%>
<%# src/components/HeroWithForm.astro: a page's opener, its copy on the left (the block passes its lede in as the block's content) and the demo request on the right. Render it as a layout: render(layout: "website/shared/hero_with_form", locals: {…}) { … }. %>
<section class="hf-hero" data-c-hero-with-form>
  <div class="wrap hf-grid" data-c-hero-with-form>
    <div class="hf-copy" data-c-hero-with-form>
      <% if logo.present? %><%= tag.img src: logo, alt: logo_alt, class: "hf-logo", data: {c_hero_with_form: ""} %><% end %>
      <span class="eyebrow" data-c-hero-with-form><%= eyebrow %></span>
      <h1 data-c-hero-with-form><%= title %></h1>
      <%= yield %>
      <a href="<%= stella_site[:phone_href] %>" class="hf-call" data-c-hero-with-form>Prefer to talk? Call <%= stella_site[:phone] %> →</a>
    </div>

    <div class="hf-form" data-c-hero-with-form>
      <%= render "website/shared/demo_form", id: form_id, tone: "light" %>
    </div>
  </div>
</section>
