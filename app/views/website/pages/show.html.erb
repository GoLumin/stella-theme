<%# locals: (page:) -%>
<%# Every CMS page, from its blocks in order (src/pages/[slug].astro, index.astro, and the blog, case-studies and featured-customers indexes, whose listings are blocks too). %>
<% content_for :head, stella_seo_tags(page, title: page.title) %>
<%# The Astro site's block bundle (and with it the closers' mobile body padding) loaded on every page drawn from blocks, but not on its three collection indexes. %>
<% content_for :blocks_page, "yes" unless %w[blog case-studies featured-customers].include?(page.path) %>
<%= website_blocks page %>
