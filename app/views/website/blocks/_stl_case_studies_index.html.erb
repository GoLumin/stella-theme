<%# locals: (data:) -%>
<%# src/pages/case-studies/index.astro: the case studies' hero and "more" link (the block's copy), and every case study in the collection's order. %>
<%= render layout: "website/shared/hero_with_form", locals: {eyebrow: stella_str(data.eyebrow), title: stella_str(data.heading), form_id: "solutions-demo"} do %>
  <p class="lede" data-c-case-studies-index><%= stella_str(data.lede) %></p>
<% end %>

<section class="section" data-c-case-studies-index>
  <div class="wrap" data-c-case-studies-index>
    <div class="grid grid-2" data-c-case-studies-index>
      <% stella_case_studies.each do |study| %>
        <a class="card card-hover cs-card" href="/case-studies/<%= study[:slug] %>" data-c-case-studies-index>
          <div class="cs-top" data-c-case-studies-index>
            <% if study[:logo] %><%= stella_image_tag(study[:logo], sizes: "12rem", alt: "", class: "cs-logo", loading: "lazy", data: {c_case_studies_index: ""}) %><% end %>
            <div data-c-case-studies-index>
              <h3 data-c-case-studies-index><%= study[:company] %></h3>
              <% if study[:location] %><span class="cs-loc" data-c-case-studies-index><%= study[:location] %></span><% end %>
            </div>
          </div>

          <p data-c-case-studies-index><%= study[:summary] %></p>

          <ul class="chips" data-c-case-studies-index>
            <% study[:results].first(2).each do |result| %>
              <li class="chip" data-c-case-studies-index><%= result %></li>
            <% end %>
          </ul>

          <span class="link-arrow" data-c-case-studies-index>Read the case study</span>
        </a>
      <% end %>
    </div>

    <% if (more_label = stella_str(data.more_label)).present? && (more_href = stella_href(data.more_href)) %>
      <div class="cs-more" data-c-case-studies-index>
        <%= link_to more_label, more_href, class: "btn btn-ink", data: {c_case_studies_index: ""} %>
      </div>
    <% end %>
  </div>
</section>
