<%# locals: (data:) -%>
<%# src/components/blocks/PartnersCategories.astro: the partner categories grid. %>
<section class="section section-alt" data-c-partners-categories>
  <div class="wrap" data-c-partners-categories>
    <div class="section-head" data-c-partners-categories>
      <span class="eyebrow" data-c-partners-categories><%= stella_str(data.eyebrow) %></span>
      <h2 data-c-partners-categories><%= stella_str(data.heading) %></h2>
    </div>
    <div class="grid grid-3" data-c-partners-categories>
      <% data.cards.each do |card| %>
        <div class="card cat" data-c-partners-categories>
          <h3 data-c-partners-categories><%= stella_str(card.title) %></h3>
          <p data-c-partners-categories><%= stella_str(card.body) %></p>
        </div>
      <% end %>
    </div>
  </div>
</section>
