<%# locals: (data:) -%>
<%# src/components/blocks/HomeConsole.astro: the home page's product section — heading copy, a screenshot of the product (`image`, from the media library) and two calls to action. It used to draw an HTML mock of the ops console; that mock's fields are still in the CMS but nothing draws them. %>
<% image = (data.image if website_image(data.image)).to_s %>
<section class="v-section v-dark console-sec" id="console" data-c-home-console>
  <div class="v-wrap v-wrap-wide" data-c-home-console>
    <div class="v-head reveal" data-c-home-console>
      <span class="v-eyebrow" data-c-home-console><%= stella_str(data.eyebrow) %></span>
      <h2 data-c-home-console><%= stella_str(data.heading) %></h2>
      <p class="v-lede" data-c-home-console><%= stella_str(data.lede) %></p>
    </div>

    <% if image.present? %>
      <figure class="console-shot reveal" data-c-home-console>
        <%= stella_image_tag(image, sizes: "(max-width: 1280px) 100vw, 1280px", alt: stella_str(data.image_alt), loading: "lazy", decoding: "async", data: {c_home_console: ""}) %>
      </figure>
    <% end %>

    <div class="v-btn-row v-center console-cta reveal" style="justify-content:center" data-c-home-console>
      <a href="#demo" class="v-btn v-btn-primary v-btn-lg" data-c-home-console><%= stella_str(data.primary_label) %></a>
      <a href="<%= stella_href(stella_str(data.secondary_href, "/features")) %>" class="v-btn v-btn-ghost v-btn-lg" data-c-home-console><%= stella_str(data.secondary_label) %></a>
    </div>
  </div>
</section>
