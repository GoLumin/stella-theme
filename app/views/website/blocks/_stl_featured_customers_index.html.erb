<%# locals: (data:) -%>
<%# src/pages/featured-customers/index.astro: the featured customers' hero (the block's copy) and every featured customer. %>
<% customers = stella_featured_customers %>
<%= render layout: "website/shared/hero_with_form", locals: {eyebrow: stella_str(data.eyebrow, "Featured customer"), title: stella_str(data.heading, "The operators behind the containers"), form_id: "featured-demo"} do %>
  <p class="lede" data-c-featured-customers-index><%= stella_str(data.lede) %></p>
<% end %>

<section class="section" data-c-featured-customers-index>
  <div class="wrap" data-c-featured-customers-index>
    <% if customers.empty? %>
      <p class="lede" data-c-featured-customers-index>The first featured customer is on the way.</p>
    <% else %>
      <div class="grid grid-2" data-c-featured-customers-index>
        <% customers.each do |customer| %>
          <a class="card card-hover fc-card" href="/featured-customers/<%= customer[:slug] %>" data-c-featured-customers-index>
            <% if customer[:image] %><%= stella_image_tag(customer[:image], sizes: "(max-width: 1220px) 100vw, 1180px", alt: "", class: "fc-img", loading: "lazy", data: {c_featured_customers_index: ""}) %><% end %>
            <div class="fc-top" data-c-featured-customers-index>
              <% if customer[:logo] %><%= stella_image_tag(customer[:logo], sizes: "12rem", alt: "", class: "fc-logo", loading: "lazy", data: {c_featured_customers_index: ""}) %><% end %>
              <div data-c-featured-customers-index>
                <h3 data-c-featured-customers-index><%= customer[:company] %></h3>
                <% if customer[:location] %><span class="fc-loc" data-c-featured-customers-index><%= customer[:location] %></span><% end %>
              </div>
            </div>

            <p data-c-featured-customers-index><%= customer[:summary] %></p>

            <% if customer[:customer_since] %>
              <ul class="chips" data-c-featured-customers-index>
                <li class="chip" data-c-featured-customers-index>Stella customer since <%= customer[:customer_since] %></li>
              </ul>
            <% end %>

            <span class="link-arrow" data-c-featured-customers-index>Read their story</span>
          </a>
        <% end %>
      </div>
    <% end %>
  </div>
</section>
